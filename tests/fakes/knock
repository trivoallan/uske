#!/usr/bin/env python3
"""A fake `knock`: writes frozen plans from tests/fixtures/fakes/plans, and what it would place.

    knock reconcile <work>/policies/<name> --plan-out FILE
    knock reconcile <work>/policies/<name> --apply-plan FILE [--stage-to T --staged-out FILE]
                                           --applied-out FILE
    knock promote <work>/policies/<name> --staged FILE

The policy is the directory's name; its plan is FAKE_PLANS/<name>.json (default: the fixtures),
an empty plan if there is none. An approved operation is imported, unless it carries a remediation
order: it is then held in the transit when one is given, withheld otherwise. Held and written
digests derive from the source digest (`held_digest`, `placed_digest`).

FAKE_FAIL, comma-separated `step` or `step:policy` (step: plan, apply, promote), makes that step
exit 1; an apply that fails still writes what it did. Each call is logged to FAKE_CALLS.
"""

import hashlib
import json
import os
import shlex
import sys
from pathlib import Path

PLANS = Path(__file__).resolve().parent.parent / "fixtures" / "fakes" / "plans"


def held_digest(source: str) -> str:
    return "sha256:" + hashlib.sha256(f"held:{source}".encode()).hexdigest()


def placed_digest(source: str) -> str:
    return "sha256:" + hashlib.sha256(f"placed:{source}".encode()).hexdigest()


def option(argv: list[str], name: str) -> str | None:
    return argv[argv.index(name) + 1] if name in argv else None


def fails(step: str, policy: str) -> bool:
    wanted = [w for w in (os.environ.get("FAKE_FAIL") or "").split(",") if w]
    return step in wanted or f"{step}:{policy}" in wanted


def write(path: str, value: dict) -> None:
    Path(path).write_text(json.dumps(value, indent=2))


def apply(argv: list[str], policy: str) -> None:
    plan = json.loads(Path(option(argv, "--apply-plan")).read_text())
    transit, staged_out = option(argv, "--stage-to"), option(argv, "--staged-out")
    applied, held = [], []
    for op in plan.get("operations") or []:
        base = {k: op[k] for k in ("policy", "destination", "tag", "sourceDigest")}
        if not op.get("remediate"):
            applied.append(
                {**base, "kind": "imported", "writtenDigest": placed_digest(op["sourceDigest"])}
            )
        elif transit and staged_out:
            held.append(
                {
                    **base,
                    "import": "v1",
                    "variant": "default",
                    "kind": op["kind"],
                    "source": op["source"],
                    "sourceTag": op["sourceTag"],
                    "staged": f"harbor.example/{transit}/app",
                    "stagedDigest": held_digest(op["sourceDigest"]),
                    "epoch": op["remediate"].get("epoch") or "",
                    "aliases": [],
                }
            )
        else:
            applied.append({**base, "kind": "withheld", "reason": "remediation-unstaged"})
    if staged_out:
        write(staged_out, {"kind": "StagedRebuilds", "entries": held})
    write(option(argv, "--applied-out"), {"kind": "AppliedOperations", "operations": applied})


def main(argv: list[str]) -> int:
    if os.environ.get("FAKE_CALLS"):
        with open(os.environ["FAKE_CALLS"], "a") as log:
            log.write(shlex.join(["knock", *argv]) + "\n")
    verb, policy = argv[0], Path(argv[1]).name
    if verb == "promote":
        return 1 if fails("promote", policy) else 0
    if "--plan-out" in argv:
        if fails("plan", policy):
            return 1
        source = Path(os.environ.get("FAKE_PLANS") or PLANS) / f"{policy}.json"
        plan = json.loads(source.read_text()) if source.exists() else {"operations": []}
        write(option(argv, "--plan-out"), plan)
        return 0
    apply(argv, policy)
    return 1 if fails("apply", policy) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
